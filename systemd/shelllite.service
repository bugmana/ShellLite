[Unit]
Description=ShellLite Web Development Server
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/ShellLite
Environment="PATH=%h/.local/share/flutter/bin:%h/flutter/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/share/flutter/bin/flutter run -d web-server --web-port=8080 --web-hostname=127.0.0.1 --base-href / --pid-file /tmp/shelllite.pid
ExecReload=/usr/bin/pkill -USR1 -f "flutter_tools.*web-server"
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
