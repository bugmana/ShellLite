[Unit]
Description=Rebuild ShellLite Web on File Change

[Service]
Type=oneshot
WorkingDirectory=%h/projects/ShellLite
Environment="PATH=%h/.local/share/flutter/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/share/flutter/bin/flutter build web
ExecStartPost=/bin/chmod -R a+rX %h/projects/ShellLite/build/web
